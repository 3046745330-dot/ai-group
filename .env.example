# =============================================================================
# AI 工作群 · 桌面版密钥配置
# -----------------------------------------------------------------------------
# 用法：把本文件复制为 **.env**（同一目录），填入你的密钥后保存。
#   1. 打包版：.env 与 exe 放在同一目录（即 ai-group-desktop\ 下）
#   2. 源码版：.env 放在 ai-group\ 目录下
#
# 规则：
#   * 只写「键=值」，不要加引号、不要在等号两边加空格；
#   * 已经存在的系统环境变量优先，本文件不会覆盖它们；
#   * 本文件含密钥，不要提交到 git、不要发群里。
#
# 只需要填你用得到的那几行，其余留空即可。
# =============================================================================

# DeepSeek 官方 API（组长默认用它；去 platform.deepseek.com 创建）
DEEPSEEK_API_KEY=

# Kimi / Moonshot 国内站（组员·论证担当默认用它；去 platform.moonshot.cn 创建）
MOONSHOTAI_CN_API_KEY=

# 火山方舟豆包（组员·快速反驳默认用它；去 console.volcengine.com/ark 创建）
# 注意：该账号需先在控制台「开通管理」里开通模型，否则会报 ModelNotOpen / 欠费
ARK_API_KEY=

# OpenAI（留桩成员，默认未启用；国内直连需自备代理）
OPENAI_API_KEY=
